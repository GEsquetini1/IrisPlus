{
  "manifest_version": 3,
  "name": "Iris+ HTTP",
  "version": "1.2",
  "description": "Painel flutuante para compensação ocular em tempo real usando dados de eye-tracking via HTTP",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["irisplus-http.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "icons": {
    "128": "icon.png"
  }
}